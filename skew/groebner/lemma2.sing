LIB "elim.lib";
// Specialise Y0=2, Y1=3 (char 32003). Unknowns: cubic C (10 coeffs), shift c, and
// l2 = (a0+a1*y+a2*y^2)/(b0+b1*y+b2*y^2). Impose K(y) = C(p, l2, P4/l2) identically in y.
// Expect: on every component, b1=b2=0 (l2 polynomial in y) or a1=a2=0 (l3 polynomial in y).
option(redSB);
ring R = 32003, (C300,C210,C201,C120,C111,C102,C030,C021,C012,C003,c,a0,a1,a2,b0,b1,b2,y), dp;
poly Y0 = 2; poly Y1 = 3;
poly p = Y0*Y1; poly t = Y0^2-Y1^2; poly P4 = p*t - c*p^2;
poly N = a0+a1*y+a2*y^2; poly D = b0+b1*y+b2*y^2;
poly K = Y0^6+Y1^6+y^6;
// l2 = N/D, l3 = P4*D/N ; multiply identity by N^3*D^3
poly lhs = K*N^3*D^3;
poly rhs = C300*p^3*N^3*D^3 + C210*p^2*N^4*D^2 + C201*p^2*P4*N^2*D^4 + C120*p*N^5*D
         + C111*p*P4*N^3*D^3 + C102*p*P4^2*N*D^5 + C030*N^6 + C021*P4*N^4*D^2
         + C012*P4^2*N^2*D^4 + C003*P4^3*D^6;
poly E = lhs - rhs;
matrix M = coeffs(E, y);
ideal I = M;
// normalisations / nondegeneracy: N, D coprime-ish and l2 nonconstant in y
I = I, b0 - 1;                       // scale (D(0) != 0 chart)
// remove l2 constant in y: need (a1,a2,b1,b2) generic; saturate by the ideal of
// "D constant in y" (b1,b2) and by "N constant in y" (a1,a2): what survives is a
// genuinely rational l2 with neither l2 nor l3 polynomial in y.
ideal S1 = b1, b2;
ideal S2 = a1, a2;
I = sat(I, S1);
print("after sat (b1,b2):"); print(dim(std(I)));
I = sat(I, S2);
ideal J = std(I);
print("after sat (a1,a2):"); print(dim(J)); print(J);
quit;
